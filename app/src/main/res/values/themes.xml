<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.MerchantMate" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/merchant_primary</item>
        <item name="colorPrimaryVariant">@color/merchant_primary_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/merchant_bg</item>
        <item name="android:navigationBarColor">@android:color/white</item>

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.MerchantMate" parent="Base.Theme.MerchantMate" />

    <style name="Theme.MerchantMate.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/merchant_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.MerchantMate</item>
    </style>

</resources>