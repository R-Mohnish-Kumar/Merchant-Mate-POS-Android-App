<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cartItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_cart_item"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvCartItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Product Name"
        android:textColor="#111827"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCartItemPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="£0.00 each"
        android:textColor="#6B7280"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDecreaseCartItem"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="-"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/tvCartItemQuantity"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1"
            android:textColor="#111827"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnIncreaseCartItem"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="+"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/tvCartItemLineTotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="end"
            android:text="£0.00"
            android:textColor="#2563EB"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRemoveCartItem"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:text="Remove"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>